{
  "name": "plume-icons",
  "displayName": "Plume Icons",
  "description": "Plume product icon theme for VS Code",
  "version": "0.0.1",
  "publisher": "plume",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "productIconThemes": [
      {
        "id": "plume",
        "label": "Plume",
        "path": "dist/plume-product-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "bun src/index.ts",
    "typecheck": "tsc",
    "package": "bun run build && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@types/bun": "^1.4.2",
    "@vscode/vsce": "^4.0.0",
    "fantasticon": "^4.1.0",
    "typescript": "^7.0.2",
    "xmlbuilder2": "^4.0.3"
  }
}
